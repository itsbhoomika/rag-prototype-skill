# Copy to .env and fill in what you have. .env is git-ignored. Never paste keys into chat.

# ---- Which providers to use
LLM_PROVIDER=anthropic          # anthropic | openai | azure | gemini | ollama | offline (test stub, labelled)
LLM_MODEL=                      # blank = provider default (see backend/providers.py)
EMBED_PROVIDER=none             # openai | azure | gemini | ollama | local | none
EMBED_MODEL=

# ---- Keys (only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Claude options
CLAUDE_EFFORT=low               # low | medium | high (higher = slower, more careful)
CLAUDE_FALLBACKS=1              # 0 if a proxy rejects the refusal-fallback beta

# ---- Retrieval knobs
CHUNK_SIZE=1200                 # characters
CHUNK_OVERLAP=150
TOP_K=6
CANDIDATES=30
MIN_VECTOR_SIM=0.25

# ---- Paths
DATA_DIR=data/sample
USERS_FILE=data/users.json
